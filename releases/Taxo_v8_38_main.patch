+def _worklog_segments_consistency(row, segments):
+    """Перевіряє узгодженість головного запису табеля з його деталізацією.
+
+    Для місячного графіка головним джерелом є worklog — тобто той самий
+    запис, який показується у вкладці «Табель». work_segments не має
+    права непомітно підміняти підсумкові години або керування.
+    """
+    issues=[]
+    if row is None:
+        return issues
+
+    row_work=hours_value_to_minutes(row["work_hours"])
+    row_drive=hours_value_to_minutes(row["driving_hours"])
+
+    if segments:
+        try:
+            ordered=sorted(segments,key=lambda s:(s["segment_no"],time_to_minutes(s["start_time"])))
+            seg_work=sum(hours_value_to_minutes(s["work_hours"]) for s in ordered)
+            seg_drive=sum(hours_value_to_minutes(s["driving_hours"]) for s in ordered)
+            seg_start=(ordered[0]["start_time"] or "").strip()
+            seg_end=(ordered[-1]["end_time"] or "").strip()
+
+            if abs(seg_work-row_work)>1:
+                issues.append(
+                    f"робота: табель {minutes_hhmm(row_work)}, частини {minutes_hhmm(seg_work)}"
+                )
+            if abs(seg_drive-row_drive)>1:
+                issues.append(
+                    f"керування: табель {minutes_hhmm(row_drive)}, частини {minutes_hhmm(seg_drive)}"
+                )
+
+            row_start=(row["start_time"] or "").strip()
+            row_end=(row["end_time"] or "").strip()
+            if row_start and seg_start and row_start!=seg_start:
+                issues.append(f"початок: табель {row_start}, частини {seg_start}")
+            if row_end and seg_end and row_end!=seg_end:
+                issues.append(f"кінець: табель {row_end}, частини {seg_end}")
+        except Exception as e:
+            issues.append(f"не вдалося перевірити частини: {e}")
+
+    return issues
+
