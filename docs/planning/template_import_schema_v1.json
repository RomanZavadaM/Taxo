{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RomanZavadaM/Taxo/blob/main/docs/planning/template_import_schema_v1.json",
  "title": "Taxo Template Package v1: individual template",
  "description": "Private import candidate. Not an approved legal document or a document record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "template_id",
    "title",
    "document_kind",
    "scenario",
    "language",
    "status",
    "source_refs",
    "variables",
    "blocks"
  ],
  "properties": {
    "format": {
      "const": "taxo.template.v1"
    },
    "template_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{4,95}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 250
    },
    "description": {
      "type": "string"
    },
    "document_kind": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "scenario": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "language": {
      "const": "uk"
    },
    "status": {
      "const": "proposed"
    },
    "volume": {
      "enum": [
        "short",
        "standard",
        "extended",
        "long_form"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 250
      },
      "uniqueItems": true
    },
    "source_notes": {
      "type": "string"
    },
    "legal_review": {
      "enum": [
        "not_checked",
        "requires_review"
      ]
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "type": {
            "enum": [
              "text",
              "date",
              "integer",
              "person_ref",
              "vehicle_ref",
              "pairs",
              "participants",
              "sections",
              "table_rows"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "label": {
            "type": "string",
            "maxLength": 150
          },
          "description": {
            "type": "string"
          }
        }
      },
      "uniqueItems": true
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "appendices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/appendix"
      }
    },
    "quality_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needs_owner_review": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "type": {
          "enum": [
            "heading",
            "paragraph",
            "numbered_list",
            "bullet_list",
            "table",
            "dynamic_table",
            "page_break",
            "signature_placeholder",
            "attachment_reference",
            "figure"
          ]
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "text": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "data_source": {
          "type": "string"
        },
        "visible_when": {
          "type": "string",
          "description": "Only declarative approved condition code, never executable expression"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "appendix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "blocks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "title": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    }
  }
}
